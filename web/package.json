{
  "name": "@ai-boss/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "cd .. && eslint web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tauri-db.json",
    "test": "vitest run",
    "test:tz": "TZ=America/New_York vitest run",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --config vite.app.config.ts",
    "test:tauri-db": "vitest run --config vitest.tauri-db.config.ts"
  },
  "dependencies": {
    "@tauri-apps/plugin-sql": "~2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
