# api バックエンド利用時のみ必須（Claude Code ログイン済みなら claude-code バックエンド既定では不要）
ANTHROPIC_API_KEY=
DB_PATH=./data/ai-boss.db
# LLM 呼び出しバックエンド。許容値: claude-code（既定・Claude Code サブスクリプション認証） / api（Claude API 従量課金）
# 未設定（コメントアウトのまま）で claude-code になる。api 従量課金経路に戻すには次の行を有効化し、ANTHROPIC_API_KEY を設定すること
# LLM_BACKEND=api
PORT=8787
